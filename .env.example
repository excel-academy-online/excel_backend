# ---------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in .env file.
# ---------------------------------------------------------------

# "development" or "production". The global error handler returns a
# 300 error page if this is unset, so it is required.
NODE_ENV=development
PORT=7070

# --- Database -------------------------------------------------
Mongo_Uri=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# --- Firebase Admin (server credentials) ----------------------
# Base64 of the whole service-account JSON file. Generate with:
#   base64 -w0 serviceAccountKey.json
# Preferred over keeping the raw .json file on disk.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional: path to a service-account JSON file instead of the above.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_DATABASE_URL=https://excel-academy-online-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=excel-academy-online.appspot.com

# --- Firebase client config (public values) -------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Payments -------------------------------------------------
Paystack_Secret_Key=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Video encryption (utils/encryptVideo.js) -----------------
# 32-byte hex key and 16-byte hex IV for aes-256-cbc.
key=
iv=

# --- Data source -----------------------------------------------
# Which database the live course + payment endpoints read from.
#   mongo     (default) current production behaviour
#   firestore the migration target
# Flip to firestore only after `npm run inspect` confirms the Firestore
# `courses` collection holds the real catalogue. Reversible: change it back
# and redeploy.
DATA_SOURCE=mongo

# Comma-separated allowlist for CORS. Empty allows all origins.
CORS_ORIGINS=
